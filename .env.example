# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real keys. Loaded automatically via python-dotenv wherever
# a script calls load_dotenv() (currently: disruption_response.py).

# Which provider disruption_response.py's decide() calls - "gemini" or "ollama".
LLM_PROVIDER=gemini

# Gemini API key for disruption_response.py's Layer 1 LLM call.
# Either name works - GOOGLE_API_KEY wins if both are set.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Ollama Cloud API key (https://ollama.com/settings/keys) - for glm-5.3:cloud.
OLLAMA_API_KEY=
